{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klik Content",
  "version": "0.2.0",
  "identifier": "dk.rtpm.klik.content",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Klik",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "width": 800,
        "height": 600
      },
      {
        "label": "studio",
        "title": "Klik Content",
        "visible": false,
        "width": 1380,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "publisher": "Real Time Project Management",
    "shortDescription": "Klik Content: screenshots til LinkedIn-karrusel og præsentation"
  }
}
